          created: 1780161137962
          modified: 1785503619421
          isPrivate: false
          description: >-
            Autentica um admin e retorna o JWT.

            Copie o token retornado e cole na variável de ambiente
            `admin_token`.
          sortKey: -1780161137962
        method: POST
        body:
          mimeType: application/json
          text: '{ "email": "admin@arraia.com", "password": "310763" }'
        headers:
          - name: Content-Type
            value: application/json
        scripts:
          afterResponse: |
            let body;

            try {
              body = insomnia.response.json();
            } catch {
              return;
            }

            if (body?.token) {
              insomnia.environment.set("admin_token", body.token);
            }
        settings:
          renderRequestBody: true
          encodeUrl: true
          followRedirects: global
          cookies:
            send: true
            store: true
          rebuildPath: true
