            ⛔ 403 — IP diferente do primeiro acesso (convite de outra pessoa).
            ❌ 404 — código não encontrado.
          sortKey: -1780161137982
        method: POST
        body:
          mimeType: application/json
          text: |-
            {
              "code": "c9e6197d",
              "fingerprint": "fp_abc123"
