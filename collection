          - name: Content-Type
            value: multipart/form-data
          - name: Authorization
            value: Bearer {{ admin_token }}
            description: ""
            disabled: false
        settings:
          renderRequestBody: true
          encodeUrl: true
          followRedirects: global
          cookies:
            send: true
            store: true
          rebuildPath: true
  - name: 📩 Invite (público)
