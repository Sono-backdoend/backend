        meta:
          id: req_c83d3f7121a25b3e21ecb2ab9ff7ac2a
          created: 1785778976003
          modified: 1785778976003
          isPrivate: false
          description: |-
            Cria um convidado que só pode confirmar presença dentro de uma janela
            de data/hora específica (independente da data do evento).

            ✅ 201 — convidado criado, retorna a janela definida.
            ⛔ 400 — confirmationStartsAt e confirmationEndsAt devem ser enviados
            juntos, com início anterior ao fim.
          sortKey: -1780161137973.5
        method: POST
        body:
          mimeType: application/json
          text: |-
            {
              "name": "Kauã Werle",
              "confirmationStartsAt": "2026-08-04T14:00:00-03:00",
              "confirmationEndsAt": "2026-08-05T14:00:00-03:00"
