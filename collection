          isPrivate: false
          description: |-
            Cria um novo convidado. O código único é gerado automaticamente.
            Retorna: id, name, code, confirmationStartsAt, confirmationEndsAt, createdAt.

            confirmationStartsAt/confirmationEndsAt são opcionais — se omitidos,
            o convidado fica sem restrição de prazo para confirmar.
          sortKey: -1780161137974
        method: POST
        body:
          mimeType: application/json
          text: |+
            {
              "name": "Kauã Werle"
            }

        headers:
          - name: Content-Type
            value: application/json
